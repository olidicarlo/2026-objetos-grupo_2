import TP.*

describe "Guerrero" {

const goku = new Guerrero (potencial = 100, energiaOriginal = 1000)
const vegeta = new Guerrero (potencial = 80, energiaOriginal = 5000)

test "cuando goku ataca a vegeta, baja la energia de vegeta" {
        goku.atacar(vegeta)
        assert.equals(4990, vegeta.energiaActual())
    }

test "cuando goku ataca a vegeta, la experiencia de vegeta aumenta en 1" {
        goku.atacar(vegeta)
        assert.equals(1, vegeta.experiencia())
    }
}

//Test punto 2
test "traje comun del 3% reduce el daño" {
    const goku = new Guerrero(potencial = 100, energiaOriginal = 5000)
    const vegeta = new Guerrero(potencial = 80, energiaOriginal = 5000,
        traje = new TrajeComun(proteccion = 0.03))
    goku.atacar(vegeta)
    assert.equals(4993, vegeta.energiaActual())
}

test "traje de entrenamiento no reduce el daño" {
    const goku = new Guerrero(potencial = 100, energiaOriginal = 5000)
    const vegeta = new Guerrero(potencial = 80, energiaOriginal = 5000,
        traje = new TrajeEntrenamiento())
    goku.atacar(vegeta)
    assert.equals(4990, vegeta.energiaActual())
}

test "traje de entrenamiento duplica la experiencia" {
    const goku = new Guerrero(potencial = 100, energiaOriginal = 5000)
    const vegeta = new Guerrero(potencial = 80, energiaOriginal = 5000,
        traje = new TrajeEntrenamiento())
    goku.atacar(vegeta)
    assert.equals(2, vegeta.experiencia())
}

test "se puede cambiar el traje antes de la batalla" {
    const goku = new Guerrero(potencial = 100, energiaOriginal = 5000)
    const vegeta = new Guerrero(potencial = 80, energiaOriginal = 5000)
    vegeta.traje(new TrajeComun(proteccion = 0.03))
    goku.atacar(vegeta)
    assert.equals(4993, vegeta.energiaActual())
}

//Test punto 3
test "despues de 20 ataques el traje esta gastado" {
    const goku = new Guerrero(potencial = 100, energiaOriginal = 5000)
    const traje = new TrajeComun(proteccion = 0.03)
    const vegeta = new Guerrero(potencial = 80, energiaOriginal = 5000, traje = traje)
    20.times({ i => goku.atacar(vegeta) })
    assert.that(traje.estaGastado())
}

test "un traje gastado ya no protege" {
    const goku = new Guerrero(potencial = 100, energiaOriginal = 5000)
    const vegeta = new Guerrero(potencial = 80, energiaOriginal = 5000,
        traje = new TrajeComun(proteccion = 0.03))
    20.times({ i => goku.atacar(vegeta) })
    // 20 ataques protegidos: 20 * 7 = 140 de daño -> 4860
    goku.atacar(vegeta)
    // el 21 ya sin protección: 10 de daño -> 4850
    assert.equals(4850, vegeta.energiaActual())
}

test "un traje de entrenamiento gastado ya no duplica la experiencia" {
    const goku = new Guerrero(potencial = 100, energiaOriginal = 5000)
    const vegeta = new Guerrero(potencial = 80, energiaOriginal = 5000,
        traje = new TrajeEntrenamiento())
    20.times({ i => goku.atacar(vegeta) })   // 20 ataques * 2 = 40 de experiencia
    goku.atacar(vegeta)                      // el 21 suma 1 (traje gastado)
    assert.equals(41, vegeta.experiencia())
}

// Test punto 4

test "un traje modularizado protege" {
    const goku = new Guerrero(potencial = 100, energiaOriginal = 5000)
    const vegeta = new Guerrero(potencial = 80, energiaOriginal = 5000, traje = new TrajeModularizado())
    vegeta.traje().agregarPieza(4)
    vegeta.traje().agregarPieza(1)
    goku.atacar(vegeta)
    assert.equals(4995, vegeta.energiaActual())
}